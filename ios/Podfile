# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# [bareship] Environment build configurations (scripts/ios/configure-environments.rb).
project 'BareshipApp',
        'Debug-Dev' => :debug, 'Release-Dev' => :release,
        'Debug-Staging' => :debug, 'Release-Staging' => :release,
        'Debug-Prod' => :debug, 'Release-Prod' => :release

# [bareship] Which .env file react-native-config reads for each configuration.
ENVFILES = {
  'Debug-Dev' => '.env.dev', 'Release-Dev' => '.env.dev',
  'Debug-Staging' => '.env.staging', 'Release-Staging' => '.env.staging',
  'Debug-Prod' => '.env.prod', 'Release-Prod' => '.env.prod',
}.freeze

# [bareship] React Native Firebase needs static frameworks, and refuses Swift Package Manager with them,
# so the Firebase iOS SDK comes from CocoaPods. Verified with every native library in Phase 0
# (docs/native-changes.md#firebase). USE_FRAMEWORKS can still override the linkage.
$RNFirebaseAsStaticFramework = true
$RNFirebaseDisableSPM = true
linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'BareshipApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # [bareship] Xcode 27 rejects deployment targets below iOS 15. Several pods (SDWebImage, Lottie,
    # react-native-svg, Firebase helpers) still declare 9.0–13.0 for their resource bundles; raise them
    # to the app minimum. See docs/native-changes.md#ios-deployment-target.
    installer.pods_project.targets.each do |pod_target|
      pod_target.build_configurations.each do |build_config|
        current = build_config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"]
        if current.nil? || Gem::Version.new(current) < Gem::Version.new(min_ios_version_supported)
          build_config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = min_ios_version_supported
        end
      end
    end

    # [bareship] RN sets the Swift DEBUG condition only on a configuration named "Debug".
    ENVFILES.keys.select { |name| name.start_with?('Debug') }.each do |name|
      ReactNativePodsUtils.set_build_setting(installer, build_setting: 'SWIFT_ACTIVE_COMPILATION_CONDITIONS',
                                             value: ['$(inherited)', 'DEBUG'], config_name: name)
    end

    # [bareship] Point react-native-config at the environment's .env file.
    installer.pods_project.targets.each do |pod_target|
      next unless pod_target.name == 'react-native-config'
      pod_target.build_configurations.each do |build_config|
        # The Pods project also has plain Debug/Release, which the app never builds.
        next unless ENVFILES.key?(build_config.name)
        build_config.build_settings['ENVFILE'] = ENVFILES[build_config.name]
      end
    end
  end
end
