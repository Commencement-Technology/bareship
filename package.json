{
  "name": "rn-template",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready bare React Native template (Track A).",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">= 22.11.0",
    "pnpm": ">= 11"
  },
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android --mode devDebug --appIdSuffix dev",
    "android:staging": "react-native run-android --mode stagingDebug --appIdSuffix staging",
    "android:prod": "react-native run-android --mode prodDebug",
    "ios": "react-native run-ios --scheme RnTemplate-Dev --mode Debug-Dev",
    "ios:staging": "react-native run-ios --scheme RnTemplate-Staging --mode Debug-Staging",
    "ios:prod": "react-native run-ios --scheme RnTemplate-Prod --mode Debug-Prod",
    "pods": "bundle exec pod install --project-directory=ios",
    "build:android:dev": "cd android && ./gradlew assembleDevRelease",
    "build:android:staging": "cd android && ./gradlew assembleStagingRelease",
    "build:android:prod": "cd android && ./gradlew bundleProdRelease",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm depcruise && pnpm test",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "icons": "tsx scripts/icons.ts",
    "splash": "react-native-bootsplash generate assets/brand/logo.svg --platforms=android,ios --background=FFFFFF --logo-width=120 --assets-output=assets/bootsplash",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-bootsplash": "^7.3.4",
    "react-native-config": "^1.7.2",
    "react-native-safe-area-context": "^5.5.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "sharp": "^0.35.5",
    "test-renderer": "~1.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
