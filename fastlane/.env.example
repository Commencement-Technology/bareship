# Copy to fastlane/.env (git-ignored) and fill in what you have. See docs/releasing.md.
# Lanes that need a missing value stop and name it.

# Android upload key (or put these in ~/.gradle/gradle.properties)
# RN_UPLOAD_STORE_FILE=/absolute/path/to/upload.keystore
# RN_UPLOAD_STORE_PASSWORD=
# RN_UPLOAD_KEY_ALIAS=
# RN_UPLOAD_KEY_PASSWORD=

# Google Play (android beta)
# PLAY_JSON_KEY_PATH=/absolute/path/to/play-service-account.json

# Apple (ios build, certs, beta)
# APPLE_TEAM_ID=
# MATCH_GIT_URL=git@github.com:your-org/certificates.git
# MATCH_PASSWORD=
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
