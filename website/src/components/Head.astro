---
// Starlight's <head> plus structured data: the project and site on every page, a TechArticle for each docs
// page, and FAQPage on the home, FAQ and how-to-choose pages (src/seo.ts). Google Analytics (GA4) loads only on the live domain, so local dev
// and Vercel preview URLs don't send page views. The check runs in the browser: import.meta.env in this file
// makes Astro re-read the repo's root tsconfig, which breaks the Vercel build.
import Default from '@astrojs/starlight/components/Head.astro';
import { faqPage, graph, ids, site, software, website } from '../seo';

const { entry } = Astro.locals.starlightRoute;
const url = new URL(Astro.url.pathname, site).toString();
const isHome = entry.id === 'index' || entry.id === '';

const nodes: object[] = [website, software];
if (!isHome) {
  nodes.push({
    '@type': 'TechArticle',
    '@id': `${url}#article`,
    headline: entry.data.title,
    description: entry.data.description,
    url,
    isPartOf: { '@id': ids.website },
    about: { '@id': ids.software },
    author: { '@id': ids.person },
    ...(entry.data.lastUpdated instanceof Date && { dateModified: entry.data.lastUpdated.toISOString() }),
  });
}
// Pages whose questions ("### Question" headings, or <details> on the home page) are marked up as FAQPage.
const faqPages = ['start-here/faq', 'start-here/how-to-choose'];
if ((isHome || faqPages.includes(entry.id)) && entry.body) nodes.push(faqPage(entry.body));

const gaId = 'G-DQ0L8S6KB1';
const gaScript = `if(location.hostname===${JSON.stringify(new URL(site).hostname)}){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=${gaId}';document.head.appendChild(s);window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config','${gaId}')}`;
---

<Default />
<script is:inline type="application/ld+json" set:html={graph(...nodes)} />
<script is:inline set:html={gaScript} />
