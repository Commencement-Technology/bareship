APP_ENV=staging
API_URL=https://api.staging.example.com
LOG_LEVEL=debug
API_MOCKS=false
# Deep links (ADR 0010): the app's URL scheme, and a web domain you own for universal links / App Links.
APP_SCHEME=rntemplate-staging
APP_LINK_DOMAIN=
# iOS push entitlement: development or production. Needs an Apple team; leave empty until then.
IOS_APS_ENVIRONMENT=
